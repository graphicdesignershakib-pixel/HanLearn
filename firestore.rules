rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'graphicdesigner.shakib@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // User profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Educational learning resources
    match /resources/{resourceId} {
      // Anyone signed in (or learning Chinese) can read learning resources
      allow read: if true;
      // Only admins can create, update, or delete resources
      allow create: if isAdmin() && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }
  }
}
